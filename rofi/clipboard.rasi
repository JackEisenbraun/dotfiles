@import "config.rasi"

/* --- TokyoNight Color Palette --- */
* {
    bg-color:      #1a1b26;  /* Deep storm background */
    bg-selected:   #2f334d;  /* Dark purple/blue highlight */
    fg-color:      #a9b1d6;  /* Soft silver/blue text */
    fg-selected:   #73daca;  /* Bright neon teal for selection */
    border-color:  #bb9af7;  /* Vivid purple border */
}

window {
    width:            530px;
    background-color: @bg-color;
    border:           2px;
    border-color:     @border-color;
    border-radius:    10px;      /* Rounded corners */
    padding:          10px;
}

inputbar {
    enabled: false;
}

listview {
    columns:          1;
    lines:            5;
    cycle:            false;
    dynamic:          true;
    background-color: transparent;
    spacing:          5px;       /* Gap between items */
}

element {
    orientation:      horizontal;
    padding:          12px;
    border-radius:    6px;       /* Rounded highlight pills */
    background-color: transparent;
    text-color:       @fg-color;
    children:         [ element-text ];
}

/* When hovering or selecting an item */
element selected {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element-text {
    vertical-align:   0.5;
    horizontal-align: 0.0;
    background-color: transparent;
    text-color:       inherit;   /* Dynamically changes color based on selection */
}

element-icon {
    size:             24px;
    background-color: transparent;
}
