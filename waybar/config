// ─── MAIN MONITOR BAR ────────────────────────────────────────────────────────
[
  {
    "name": "main-bar",
    "output": "eDP-1",           // ← replace with your primary monitor output name
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "exclusive": true,

    "modules-left": [
      "custom/layout",
      "hyprland/workspaces",
      "hyprland/window",
      "mpris",
    ],

    "modules-center": [
      "custom/power-menu",
      "clock"
    ],

    "modules-right": [
      "tray",
      "pulseaudio",
      "memory",
      "custom/gpu",
      "cpu",
      "battery" // Added here so it actually displays on your bar!
    ],

    // ── Hyprland workspaces (replaces komorebi_workspaces) ──────────────────
 "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch workspace m-1 > /dev/null",
    "on-scroll-down": "hyprctl dispatch workspace m+1 > /dev/null",
    "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "urgent": "",
        "focused": "",
        "default": ""
    }
},

    // ── Active window (replaces active_window) ───────────────────────────────
    "hyprland/window": {
      "format": "{title}",
      "max-length": 56,
      "separate-outputs": true,
      "rewrite": {
        "": ""
      }
    },

    // ── Clock (replaces clock widget) ────────────────────────────────────────
    "clock": {
	"format": "{:%d.%m.%Y - %I:%M:%S}",
	"format-alt": "{:%A, %B %d, %Y (%I:%M:%S)}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
		"mode"          : "year",
		"mode-mon-col"  : 3,
		"weeks-pos"     : "right",
		"on-scroll"     : 1,
		"on-click-right": "mode",
		"format": {
			"months":     "<span color='#ffead3'><b>{}</b></span>",
			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		}
	},
	"actions": {
		"on-click-right": "mode",
		"on-click-forward": "tz_up",
		"on-click-backward": "tz_down",
		"on-scroll-up": "shift_up",
		"on-scroll-down": "shift_down"
	}
},

    // ── CPU (replaces cpu widget) ────────────────────────────────────────────
    "cpu": {
      "format": "CPU {usage}%",
      "interval": 2,
      "on-click": ""
    },

    // ── PulseAudio / volume (replaces volume widget) ─────────────────────────
    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} {format_source}",
        "format-muted": "󰅶 {format_source}"
    }, // <-- FIXED: Added missing closing bracket here

    // ── MPRIS / media (replaces media widget) ────────────────────────────────
    "mpris": {
      "format": "{title} - {artist}",
      "format-paused": "⏸ {title} - {artist}",
      "format-stopped": "",
      "max-length": 40,
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "on-scroll-up": "playerctl previous",
      "on-scroll-down": "playerctl next",
      "dynamic-len": 20,
      "tooltip": true,
      "tooltip-format": "{player}: {title}\nby {artist}\n{status}"
    },

    // ── Cava (replaces cava widget) ──────────────────────────────────────────
    "custom/cava": {
      "exec": "~/.config/waybar/scripts/cava.sh",
      "format": "{}",
      "tooltip": false,
      "interval": "once",
      "restart-interval": 3
    },

    // ── GPU (replaces gpu widget) ────────────────────────────────────────────
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "GPU {}%",
        "interval": 2
    },

    // ── Layout indicator (replaces komorebi_active_layout) ───────────────────
    "custom/layout": {
      "exec": "$HOME/.config/waybar/scripts/layout.sh",
      "format": "{}",
      "interval": 2,
      "tooltip": false
    },

    "memory": {
        "interval": 30,
        "format": "{}% ",
        "max-length": 10
    },

    // ── Wallpaper switcher (replaces wallpapers widget) ──────────────────────
    "custom/wallpaper": {
      "format": "󰸉",
      "on-click": "$HOME/.config/waybar/scripts/wallpaper.sh",
      "on-click-right": "$HOME/.config/waybar/scripts/wallpaper.sh --random",
      "tooltip": false
    },

    // ── Primary Battery ────────────────────────────
    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    }
  } // <-- FIXED: Balanced the closing object brace
] // <-- FIXED: Balanced the closing global array bracket
